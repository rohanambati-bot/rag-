# Copy to .env and fill in real values:
#   cp .env.example .env

# ─── LLM (pick ONE — Groq is FREE) ────────────────────────────────────────────
# Groq — FREE, no credit card needed.
# Sign up: https://console.groq.com → API Keys → Create
GROQ_API_KEY=

# Mistral — paid fallback (optional)
MISTRAL_API_KEY=

# Generator model (used by the RAG pipeline)
GROQ_MODEL=llama-3.1-8b-instant
LLM_MODEL=mistral-small-latest
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_RATE_LIMIT_SECONDS=3.0
MAX_CONTEXT_CHARS=12000

# Judge model — keep DIFFERENT from generator to avoid self-preference bias.
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-20b

# ─── API security ─────────────────────────────────────────────────────────────
# Required for protected API routes (including docs, metrics and architectures).
# Does NOT authenticate Streamlit. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Comma-separated origins. Never use "*" with credentials.
ALLOWED_ORIGINS=http://localhost:8501

# Per-IP rate limit (requests per minute). /evaluate is hard-capped at 5/min.
RATE_LIMIT_PER_MINUTE=30

# Bounded inputs
MAX_QUESTION_LENGTH=2000
MAX_UPLOAD_BYTES=20971520

# ─── Embedding device ─────────────────────────────────────────────────────────
# "cpu" | "cuda" | "mps"
EMBEDDING_DEVICE=cpu

# ─── Evaluation ───────────────────────────────────────────────────────────────
EVAL_DEFAULT_SAMPLES=200
EVAL_RANDOM_SEED=42
EVAL_BOOTSTRAP_ITERS=1000

# ─── Redis (defaults work for local docker-compose) ───────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Serving / API (defaults are safe) ────────────────────────────────────────
# Auth bypass — deliberate, visible opt-out for local development ONLY.
# Without API_KEY and without this bypass, protected routes return 503 (fail closed).
# Requires numeric loopback HOST and direct loopback clients; rejects proxy headers.
# Loopback is not authentication; never tunnel/proxy the opt-out remotely.
ALLOW_UNAUTHENTICATED=false
HOST=127.0.0.1
# UI: use `streamlit run app.py`; app rejects non-loopback effective settings.
# No remote/container-wide UI bind override is supported. Do not tunnel/proxy it.
# "json" | "text"
LOG_FORMAT=json
METRICS_ENABLED=true
SERVICE_NAME=rag-eval-api
SERVICE_VERSION=2.0.0
REQUEST_TIMEOUT_SECONDS=60
MAX_CONCURRENT_REQUESTS=8

# ─── OpenRouter (OpenAI-compatible gateway; optional) ─────────────────────────
# Set OPENROUTER_API_KEY to route the generator and/or judge through OpenRouter,
# sidestepping Groq's per-model daily token cap. Model ids are taken from
# GROQ_MODEL (generator) and JUDGE_MODEL (judge), interpreted as OpenRouter slugs.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Retrieval / reranking ────────────────────────────────────────────────────
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_CANDIDATES=50
# RERANK_DEVICE=            # "" → auto-detect (cuda → mps → cpu)

# ─── Vector store location ────────────────────────────────────────────────────
# Default: data/chroma_db_full (the validation-set store built by preprocess_full.py).
# data/chroma_db_train is the separate train-split store from train_in_shards.py.
# VECTOR_STORE_DIR=data/chroma_db_full
