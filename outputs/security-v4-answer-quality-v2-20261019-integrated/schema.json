{
  "$id": "answer-quality.dataset/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "not": {
                "required": [
                  "scripted_output"
                ]
              }
            },
            "if": {
              "properties": {
                "mode": {
                  "const": "scripted"
                }
              }
            },
            "then": {
              "required": [
                "scripted_output"
              ]
            }
          }
        ],
        "properties": {
          "category": {
            "enum": [
              "supported",
              "unsupported",
              "conflict",
              "malicious",
              "citation_failures",
              "malformed_outputs",
              "evidence_scoping",
              "semantic_unknowns"
            ]
          },
          "context_cap": {
            "type": "integer"
          },
          "documents": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "metadata": {
                  "type": "object"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text",
                "metadata"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "expected_reason": {
            "minLength": 1,
            "type": "string"
          },
          "expected_status": {
            "enum": [
              "answer",
              "abstain"
            ]
          },
          "id": {
            "pattern": "^[a-z]{3}-[0-9]{2}$",
            "type": "string"
          },
          "mode": {
            "enum": [
              "extractive",
              "scripted"
            ]
          },
          "observe_literals": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "question": {
            "type": "string"
          },
          "scripted_output": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "mode",
          "question",
          "documents",
          "expected_status",
          "expected_reason"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 64,
      "type": "array"
    },
    "dataset_version": {
      "const": "2.0.0"
    },
    "default_context_cap": {
      "const": 12000
    },
    "description": {
      "type": "string"
    },
    "schema_version": {
      "const": "answer-quality.dataset/v2"
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "description",
    "default_context_cap",
    "cases"
  ],
  "type": "object"
}
